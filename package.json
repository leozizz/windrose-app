{
  "name": "windrose-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,edge -c blue,magenta \"pnpm --filter web dev\" \"pnpm --filter @windrose/edge-api dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:edge": "pnpm --filter @windrose/edge-api dev",
    "build": "pnpm --filter web build",
    "build:edge": "pnpm --filter @windrose/edge-api exec wrangler deploy --dry-run",
    "deploy:edge": "pnpm --filter @windrose/edge-api exec wrangler deploy --minify",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "standards:sync": "node tools/agent-standards/bin/agent-standards.mjs sync",
    "standards:review": "node tools/agent-standards/bin/agent-standards.mjs review",
    "standards:discover": "node tools/agent-standards/bin/agent-standards.mjs discover",
    "task:handoff": "node scripts/paperclip-task.mjs",
    "sync:status": "node scripts/paperclip-sync.mjs --status",
    "sync:board": "node scripts/paperclip-sync.mjs --board",
    "sync:sync": "node scripts/paperclip-sync.mjs --sync",
    "sync:dispatch": "node scripts/paperclip-sync.mjs --dispatch-next",
    "sync:close": "node scripts/paperclip-sync.mjs --close-current",
    "task:unblock": "node scripts/paperclip-unblock.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "~3.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "hono": "^4.13.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "less",
      "workerd"
    ]
  }
}
