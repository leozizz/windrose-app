# Windrose App - Environment Configuration
# Architecture: Cloudflare Pages (Frontend) + Cloudflare Workers / Pages Functions (Edge API)
# Operational Cost: $0.00 (Open-Meteo, OpenStreetMap Nominatim/Overpass, Wikimedia API)

# Edge API Configuration (Wrangler local dev runs on 8787)
PORT=8787
FRONTEND_URL=http://localhost:4200

# Frontend React Environment Variables (Vite prefixed)
# In development, leave blank to use the Vite dev server proxy (/api -> http://localhost:8787)
# In staging/production or cross-origin setups, point to your Cloudflare Pages/Workers URL
VITE_API_URL=
